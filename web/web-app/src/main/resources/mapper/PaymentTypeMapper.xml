<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nest.renting.web.app.mapper.PaymentTypeMapper">

    <select id="selectPaymentTypeById" resultType="com.nest.renting.model.entity.PaymentType">
        select id,
               name,
               pay_month_count,
               additional_info
        from payment_type
        where id = #{id}
    </select>

</mapper>