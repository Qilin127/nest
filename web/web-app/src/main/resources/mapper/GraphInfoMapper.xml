<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nest.renting.web.app.mapper.GraphInfoMapper">

    <select id="selectListByItemTypeAndId" resultType="com.nest.renting.web.app.vo.graph.GraphVo">
        SELECT name,
        url
        FROM graph_info
        where is_deleted = 0
        AND item_type = #{itemType}
        AND item_id = #{id}
    </select>
</mapper>
